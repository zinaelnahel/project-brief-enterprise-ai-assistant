OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Use chroma after starting the server and running npm run index:chroma.
RETRIEVAL_PROVIDER=chroma
CHROMA_URL=http://127.0.0.1:8000
CHROMA_COLLECTION=ironstore
CHROMA_MIN_SIMILARITY=0.4

# For Chroma Cloud, set all three (CHROMA_URL is then ignored).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
